# Keep `local` for the built-in keyless companion.
NEXT_PUBLIC_STARMATE_PROVIDER=local

# DeepSeek uses an OpenAI-compatible Chat Completions API.
# NEXT_PUBLIC_STARMATE_PROVIDER=remote
# STARMATE_LLM_API_KEY=
# STARMATE_LLM_BASE_URL=https://api.deepseek.com
# STARMATE_LLM_MODEL=deepseek-chat

# Volcengine Doubao Speech V3. Create this key in the Doubao Speech console.
# An Ark/ModelArk key is not a Doubao Speech API key.
# VOLCENGINE_TTS_API_KEY=
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
